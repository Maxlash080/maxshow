      "custom_id": "LOVED20260912",
      "slug": "love-death-ketchup-by-varun-grover",
      "title": "Love, Death & Ketchup by Varun Grover",
      "event_type": "Standup",
      "venue": "Jawaharlal Nehru Memorial Hall: Pune  4, Atur Foundation House, Dr. Ambedkar Road",
      "time": "2026-09-12 18:00",
